# Copia este archivo a .env y completa los valores reales.
# .env NUNCA se sube al repositorio (ver .gitignore).

# Conexion a PostgreSQL
DATABASE_URL=postgres://fintec:cambia-esta-clave@localhost:5432/fintec

# Secreto para firmar los JWT. Minimo 16 caracteres.
# Generalo con:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=pon-aqui-un-secreto-largo-y-aleatorio

# Puerto del API
PORT=4000

# --- opcionales ---
# RNF-01: caducidad del token (cierre de sesion por inactividad)
JWT_EXPIRES_IN=10m
# Costo de bcrypt. 10 es un buen equilibrio para desarrollo.
BCRYPT_ROUNDS=10
# Origen permitido para el front. '*' solo en desarrollo.
CORS_ORIGIN=*
NODE_ENV=development
